PORT=3001
# Per Gmail inbox daily cap (10 accounts × 200 = 2000/day max)
DAILY_LIMIT=200
SEND_DELAY_MS=20000

# Default Gmail SMTP (all personal accounts use this unless overridden)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_NAME=The Clipzy Team

# --- Up to 10 Gmail accounts (App Passwords required) ---
# Each account gets its own Data List. Upload splits leads evenly across them.

SMTP_ACCOUNT_1_USER=gmail1@gmail.com
SMTP_ACCOUNT_1_PASS=xxxx xxxx xxxx xxxx
SMTP_ACCOUNT_1_FROM_NAME=The Clipzy Team
SMTP_ACCOUNT_1_DAILY_LIMIT=200

SMTP_ACCOUNT_2_USER=gmail2@gmail.com
SMTP_ACCOUNT_2_PASS=xxxx xxxx xxxx xxxx
SMTP_ACCOUNT_2_FROM_NAME=The Clipzy Team
SMTP_ACCOUNT_2_DAILY_LIMIT=200

SMTP_ACCOUNT_3_USER=gmail3@gmail.com
SMTP_ACCOUNT_3_PASS=xxxx xxxx xxxx xxxx

SMTP_ACCOUNT_4_USER=gmail4@gmail.com
SMTP_ACCOUNT_4_PASS=xxxx xxxx xxxx xxxx

SMTP_ACCOUNT_5_USER=gmail5@gmail.com
SMTP_ACCOUNT_5_PASS=xxxx xxxx xxxx xxxx

SMTP_ACCOUNT_6_USER=gmail6@gmail.com
SMTP_ACCOUNT_6_PASS=xxxx xxxx xxxx xxxx

SMTP_ACCOUNT_7_USER=gmail7@gmail.com
SMTP_ACCOUNT_7_PASS=xxxx xxxx xxxx xxxx

SMTP_ACCOUNT_8_USER=gmail8@gmail.com
SMTP_ACCOUNT_8_PASS=xxxx xxxx xxxx xxxx

SMTP_ACCOUNT_9_USER=gmail9@gmail.com
SMTP_ACCOUNT_9_PASS=xxxx xxxx xxxx xxxx

SMTP_ACCOUNT_10_USER=gmail10@gmail.com
SMTP_ACCOUNT_10_PASS=xxxx xxxx xxxx xxxx

TEST_EMAIL=test@example.com
MAX_RETRIES=3

# Durable queue on Vercel (free Upstash Redis — required so campaigns never reset)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Protect /api/cron/sender for external cron (cron-job.org every 1–2 min)
CRON_SECRET=change-me-long-random

# Dashboard login
DASHBOARD_PASSWORD=8888
AUTH_SECRET=change-me-to-a-long-random-string
